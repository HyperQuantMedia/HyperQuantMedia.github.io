{
  "name": "hyperquantmedia.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "HyperQuant Media website — Astro static site",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "check": "astro check",
    "devview": "astro dev --host --open /devview",
    "audit": "node tools/responsive-audit.mjs",
    "vendor:fonts": "node tools/vendor-fonts.mjs",
    "vendor": "npm run vendor:fonts && npm run vendor:bootstrap",
    "vendor:bootstrap": "node tools/vendor-bootstrap.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyperQuantMedia/HyperQuantMedia.github.io.git"
  },
  "homepage": "https://hyperquantmedia.com",
  "bugs": {
    "url": "https://github.com/HyperQuantMedia/HyperQuantMedia.github.io/issues"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "three": "0.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "bootstrap": "5.3.3",
    "playwright": "1.62.1",
    "sass": "1.103.1"
  }
}
