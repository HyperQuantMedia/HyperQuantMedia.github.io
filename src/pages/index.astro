---
import Base from '../layouts/Base.astro';
import Pedigree from '../components/Pedigree.astro';
import Cta from '../components/Cta.astro';
import { site, socialLinks, email } from '../data/site.js';

// Organization schema for search engines, on the homepage only. Everything
// in it is drawn from src/data/site.js so it cannot drift from the visible
// site.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  description: site.description,
  logo: new URL('/icon-512.png', site.url).href,
  email: email.general,
  sameAs: socialLinks.map((s) => s.href),
};
---

<Base
  title="HyperQuant Media — Creative Technology & Developer Tools"
  description="HyperQuant Media builds immersive games, AR/VR experiences, applied AI, and bespoke websites — and forges its own constellation of developer tools. Creative technology for brands that want to lead."
  page="home"
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} slot="head" is:inline />

<!-- Hero -->
  <section id="home" class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <div class="hero-badge">Creative Technology <span class="badge-sep" aria-hidden="true">✦</span> Developer Tools <span class="badge-sep" aria-hidden="true">✦</span> Interactive Experiences</div>
      <h1 class="hero-title">
        <span class="title-line">We Chart the</span>
        <span class="title-line title-accent">Uncharted</span>
      </h1>
      <p class="hero-tagline">Bespoke digital products, a constellation of developer tools, and experiences people move through.</p>
      <p class="hero-sub">// games · ar-vr · applied ai · web · consulting</p>
      <div class="hero-cta d-flex flex-wrap gap-3 justify-content-center">
        <Cta href="/services">Explore Services</Cta>
        <Cta href="/cosmos" variant="ghost">See the Cosmos</Cta>
      </div>
    </div>
    <div class="scroll-indicator"><div class="scroll-line"></div></div>
  </section>

  <!-- Services Overview -->
  <section class="section-padding">
    <div class="container">
      <div class="text-center fade-in-up mb-5">
        <div class="section-label justify-content-center d-inline-flex">What We Do</div>
        <h2 class="section-title">Creative technology for every layer of your digital presence</h2>
        <p class="section-sub mx-auto">From the product you're imagining to the website your brand deserves — we design and build it.</p>
      </div>
      <div class="service-grid">
        <div class="fade-in-up delay-1">
          <a href="/services#games" class="service-card-link">
            <div class="service-card a-aurora">
              <div class="service-icon">◉</div>
              <h3 class="service-card-title">Immersive Game Development</h3>
              <p class="service-card-body">Graphics and rendering, artist and editor tooling, engine and platform work. Unreal, custom engines, Unity, Godot.</p>
              <span class="service-link">Learn more →</span>
            </div>
          </a>
        </div>
        <div class="fade-in-up delay-2">
          <a href="/services#xr" class="service-card-link">
            <div class="service-card a-polaris">
              <div class="service-icon">◇</div>
              <h3 class="service-card-title">Interactive XR Experiences</h3>
              <p class="service-card-body">AR/VR content, simulations, and immersive installations that change how people engage.</p>
              <span class="service-link">Learn more →</span>
            </div>
          </a>
        </div>
        <div class="fade-in-up delay-3">
          <a href="/services#ai" class="service-card-link">
            <div class="service-card a-rose">
              <div class="service-icon">✦</div>
              <h3 class="service-card-title">Applied AI &amp; Agent Systems</h3>
              <p class="service-card-body">Agent workflows, retrieval, and AI features built into real products — not demos.</p>
              <span class="service-link">Learn more →</span>
            </div>
          </a>
        </div>
        <div class="fade-in-up delay-4">
          <a href="/services#web" class="service-card-link">
            <div class="service-card a-nebula">
              <div class="service-icon">◈</div>
              <h3 class="service-card-title">Bespoke Web Development</h3>
              <p class="service-card-body">Custom, high-performance websites engineered from your goals. No templates, no page builders.</p>
              <span class="service-link">Learn more →</span>
            </div>
          </a>
        </div>
        <div class="fade-in-up delay-4">
          <a href="/services#consulting" class="service-card-link">
            <div class="service-card a-stellar">
              <div class="service-icon">⬡</div>
              <h3 class="service-card-title">Strategic IT Consulting</h3>
              <p class="service-card-body">Infrastructure, delivery, and technology decisions made clear for the road ahead.</p>
              <span class="service-link">Learn more →</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Industry Pedigree — the homepage's centrepiece band, sized to own
       roughly two-thirds of a viewport at any size. -->
  <Pedigree feature />

  <!-- Cosmos, in one breath. The full constellation lives on its own page;
       the homepage only points the way. -->
  <section class="ecosystem-section section-padding">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8 fade-in-up">
          <div class="text-center">
            <div class="section-label justify-content-center d-inline-flex">The Cosmos</div>
            <h2 class="section-title">We don't just use the tools. We forge them.</h2>
          </div>
          <div class="section-prose">
  <p class="section-body">
              An emerging constellation of tools, each one standing alone — built in-house
              and sharpened on our own production before they reach anyone else's.
            </p>
          </div>
          <div class="text-center">
            <Cta href="/cosmos" variant="ghost" arrow class="mt-2 d-inline-block">Chart the Constellation</Cta>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Studio, in one breath. The titles live on the Studio page. -->
  <section class="section-padding">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8 fade-in-up">
          <div class="text-center">
            <div class="section-label justify-content-center d-inline-flex">Our Studio</div>
            <h2 class="section-title">We don't just build for others. We build for ourselves too.</h2>
          </div>
          <div class="section-prose">
  <p class="section-body">
              HyperQuant runs an internal game studio on one operating principle: expertise is forged,
              not hired. Our developers work on our own titles alongside client projects — so the
              experience we bring you comes from shipping, not from theory.
            </p>
          </div>
          <div class="text-center">
            <Cta href="/studio" class="mt-2 d-inline-block">See the Studio</Cta>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section section-padding">
    <div class="container">
      <div class="cta-block text-center fade-in-up">
        <h2 class="cta-title">Ready to chart something new?</h2>
        <p class="cta-sub">// unprecedented velocity · impeccable reliability · creative vision</p>
        <Cta href="/contact" class="mt-3 d-inline-block">Get In Touch</Cta>
      </div>
    </div>
  </section>

</Base>
