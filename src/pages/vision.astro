---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
---

<Base
  title="Vision — How We Work | HyperQuant Media"
  description="HyperQuant Media's mission, vision, and values. We set new standards for innovation, creativity, and impact in everything we do."
  page="vision"
>

<!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-glow aurora"></div>
    <div class="container">
      <div class="page-hero-content">
        <div class="section-label justify-content-center d-inline-flex">Who We Are</div>
        <h1 class="page-hero-title">Vision</h1>
        <p class="page-hero-sub">Our mission goes beyond delivering digital solutions — we aim to set new standards for innovation, creativity, and impact.</p>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section-padding band">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-4 fade-in-left">
          <div class="mv-card value-card a-nebula">
            <div class="mv-head"><span class="value-icon">◎</span><div class="mv-label">Mission</div></div>
            <p class="mv-text">
              Our mission goes beyond just delivering digital solutions — we aim to set new standards
              for innovation, creativity, and impact in everything we do.
            </p>
            <p class="mv-text">
              We create compelling digital experiences by merging cutting-edge technology with creative
              storytelling. We partner with our clients as collaborators in innovation — not as vendors
              executing a brief.
            </p>
          </div>
        </div>
        <div class="col-lg-4 fade-in-up">
          <div class="mv-card value-card a-stellar">
            {/* The studio page's eight-point star, in the same stellar ink it
                wears there — one star, one colour, wherever it appears. */}
            <div class="mv-head">
              <svg class="mv-mark" viewBox="0 0 48 48" aria-hidden="true">
                <path d="M 24.00 3.00 Q 25.15 21.23 32.49 15.51 Q 26.77 22.85 45.00 24.00 Q 26.77 25.15 32.49 32.49 Q 25.15 26.77 24.00 45.00 Q 22.85 26.77 15.51 32.49 Q 21.23 25.15 3.00 24.00 Q 21.23 22.85 15.51 15.51 Q 22.85 21.23 24.00 3.00 Z" />
              </svg>
              <div class="mv-label">Belief</div>
            </div>
            <p class="mv-text">
              Applied AI runs through everything we build — as instruments, not autopilots. We use it
              for momentum: faster prototypes, cheaper failures, ten experiments where one used to fit.
            </p>
            <p class="mv-text">
              We build these systems to augment people, never to replace them: the same team attempting
              more, in breadth and in depth, with the judgement that decides what ships staying human.
              A tool is measured by what it multiplies, not by the headcount it removes. Augmented
              humans chart further.
            </p>
          </div>
        </div>
        <div class="col-lg-4 fade-in-right">
          <div class="mv-card value-card a-aurora">
            <div class="mv-head"><span class="value-icon">✧</span><div class="mv-label">Vision</div></div>
            <p class="mv-text">
              We envision shaping the future of digital experiences through emerging technology and
              authentic human connection.
            </p>
            <p class="mv-text">
              Every product we deliver — <a class="prose-link" href="/studio">a game</a>, <a class="prose-link" href="/services#web">a website</a>, <a class="prose-link" href="/services#xr">an XR experience</a>, <a class="prose-link" href="/cosmos">a developer tool</a> — should connect,
              educate, or excite the people who encounter it. Technology without that purpose is just noise.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="section-padding">
    <div class="container">
      <div class="text-center fade-in-up mb-5">
        <div class="section-label justify-content-center d-inline-flex">What Drives Us</div>
        <h2 class="section-title">Core values</h2>
      </div>
      <div class="row g-4">
        <div class="col-sm-6 col-lg-3 fade-in-up delay-1">
          <div class="value-card a-nebula">
            <div class="value-icon">⬡</div>
            <h3 class="value-title">Innovation Over Convention</h3>
            <p class="value-body">We push beyond conventional boundaries. The status quo is a ceiling, not a destination. Every project is a chance to do something that hasn't been done this way before.</p>
          </div>
        </div>
        <div class="col-sm-6 col-lg-3 fade-in-up delay-2">
          <div class="value-card a-aurora">
            <div class="value-icon">⬡</div>
            <h3 class="value-title">Authentic Connections</h3>
            <p class="value-body">We build for real people. That means understanding audiences, not just demographics — and creating genuine connection, not just impressions.</p>
          </div>
        </div>
        <div class="col-sm-6 col-lg-3 fade-in-up delay-3">
          <div class="value-card a-polaris">
            <div class="value-icon">⬡</div>
            <h3 class="value-title">Investment in Talent</h3>
            <p class="value-body">Great work comes from great people supported to grow. We invest in our team's development because the quality of what we build is inseparable from the capability of who builds it.</p>
          </div>
        </div>
        <div class="col-sm-6 col-lg-3 fade-in-up delay-4">
          <div class="value-card a-rose">
            <div class="value-icon">⬡</div>
            <h3 class="value-title">Technology + Creativity</h3>
            <p class="value-body">Technical excellence without creative vision is functional but forgettable. Creative vision without technical execution stays a sketch. We refuse to separate the two.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section-padding band">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10 text-center fade-in-up mb-5">
          <!-- The label and heading take the page's centred spine; the two
               columns below keep the section's original shape. -->
          <div class="section-label justify-content-center d-inline-flex">How We Work</div>
          <h2 class="section-title">Partners in innovation — not just service providers</h2>
        </div>
      </div>

      <div class="row align-items-center g-5">
        <div class="col-lg-5 fade-in-left">
          <p class="section-body">
            We don't hand over deliverables and disappear. We build long-term understanding of your goals,
            your audience, and your constraints — then design and build accordingly.
          </p>
          <p class="section-body">
            Our approach comes from the same adaptive philosophy we apply to our own internal game studio:
            learn fast, stabilize what works, share knowledge so the whole system improves — not just the
            individual delivering the task.
          </p>
          <Cta href="/studio" variant="ghost" arrow class="mt-2 d-inline-block">See how we build internally</Cta>
        </div>
        <div class="col-lg-6 offset-lg-1 fade-in-right">
          <div class="how-we-work-list">
            <div class="value-card hww-card a-nebula">
              <div class="hww-item">
                <div class="hww-num">01</div>
                <div>
                  <div class="hww-title">Understand before building</div>
                  <p class="hww-body">We map what you're actually trying to achieve — not just what you've asked for. The brief is where we begin, not where we stop thinking.</p>
                </div>
              </div>
            </div>
            <div class="value-card hww-card a-aurora">
              <div class="hww-item">
                <div class="hww-num">02</div>
                <div>
                  <div class="hww-title">Move fast on the right things</div>
                  <p class="hww-body">Velocity matters — but only when it's pointed in the right direction. We validate early, iterate quickly, and avoid building at speed the wrong way.</p>
                </div>
              </div>
            </div>
            <div class="value-card hww-card a-polaris">
              <div class="hww-item">
                <div class="hww-num">03</div>
                <div>
                  <div class="hww-title">Build to last</div>
                  <p class="hww-body">Every deliverable is something we'd be comfortable maintaining two years on. No technical debt passed off as finished work.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section section-padding">
    <div class="container">
      <div class="cta-block text-center fade-in-up">
        <h2 class="cta-title">Elevate your digital presence</h2>
        <p class="cta-sub">// unprecedented velocity · impeccable reliability</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap mt-3">
          <Cta href="/services">See Our Services</Cta>
          <Cta href="/contact" variant="ghost">Get In Touch</Cta>
        </div>
      </div>
    </div>
  </section>

</Base>
