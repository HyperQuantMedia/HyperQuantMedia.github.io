---
import Base from '../layouts/Base.astro';
import { tools } from '../data/products.js';
import Cta from '../components/Cta.astro';
import ToolCard from '../components/ToolCard.astro';
import ConstellationField from '../components/ConstellationField.astro';

const modules = import.meta.glob('../assets/products/*.png', {
  eager: true,
  import: 'default',
});
const icons = Object.fromEntries(
  Object.entries(modules).map(([path, img]) => [
    path.split('/').pop().replace('.png', ''),
    img,
  ]),
);

const missing = tools.filter((x) => !icons[x.slug]).map((x) => x.slug);
if (missing.length) {
  throw new Error(`Missing product icons for: ${missing.join(', ')}`);
}
---

<Base
  title="Cosmos — Developer Tools We Build | HyperQuant Media"
  description="Cosmos — HyperQuant Media's constellation of tools. Each one stands alone, built in-house and sharpened on our own production before it is pointed outward."
  page="cosmos"
>

<!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-glow polaris"></div>
    <div class="container">
      <div class="page-hero-content">
        <div class="section-label justify-content-center d-inline-flex">Our Products · In Development</div>
        <h1 class="page-hero-title">Cosmos</h1>
        <p class="page-hero-sub">A constellation of tools we forged for our own work — each one standing alone, none of them the centre. The same instruments we build with, being shaped into instruments anyone can use.</p>
      </div>
    </div>
  </section>

  <!-- Premise -->
  <section class="section-padding">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8 fade-in-up">
          <div class="text-center">
            <div class="section-label justify-content-center d-inline-flex">Why We Build Tools</div>
            <h2 class="section-title">Great work needs great instruments</h2>
          </div>
          <div class="section-prose">
  <p class="section-body">
              Building games and digital products at pace exposed a gap: the tools we wanted didn't exist yet.
              So we forged our own — for mapping a project's design, for keeping machine collaboration efficient,
              for documentation that stays true to the work, for landing a whole team in the same environment.
              They earned their keep on our own production first.
            </p>
            <p class="section-body">
              They stay separate on purpose. Each one is useful on its own, and useful alongside the others when
              that's what you want — never a bundle you have to adopt whole to get one thing you need.
            </p>
            <p class="section-body c-faint" style="font-style: italic;">
              Everything below is in active development. Names, scope, and availability will evolve as the work tells us what's next.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Field -->
  <section class="section-padding band">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10 fade-in-up">
          <div class="text-center mb-4">
            <div class="section-label justify-content-center d-inline-flex">The Field</div>
            <h2 class="section-title">Each a star in its own right</h2>
          </div>
          <ConstellationField />
        </div>
      </div>
    </div>
  </section>

  <!-- The Bodies -->
  <section class="section-padding">
    <div class="container">
      <div class="text-center fade-in-up mb-5">
        <div class="section-label justify-content-center d-inline-flex">The Bodies</div>
        <h2 class="section-title">One instrument, one job</h2>
        <p class="section-sub mx-auto">Each does its one job with conviction, and none of them depends on another. They work in tandem — they never require it.</p>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="tool-stack">
            {tools.map((prod, i) => (
              <div class={`fade-in-up delay-${Math.min(i + 1, 4)}`}>
                <ToolCard prod={prod} icon={icons[prod.slug]} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Reaches You -->
  <section class="section-padding band">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10 text-center fade-in-up mb-5">
          <!-- The label and heading take the page's centred spine; the two
               columns below keep the section's original shape. -->
          <div class="section-label justify-content-center d-inline-flex">The Approach</div>
          <h2 class="section-title">Forged on our own production first</h2>
        </div>
      </div>

      <div class="row align-items-center g-5">
        <div class="col-lg-5 fade-in-left">
          <p class="section-body">
            We don't ship tools we don't run ourselves. Every instrument in the Cosmos earns its place inside
            HyperQuant's own studio and client work before it's pointed outward. That's our quality gate — and
            our quiet promise that what we hand you, we already trust.
          </p>
          <p class="section-body">
            Each one opens outward on its own schedule, as it matures. There is nothing to adopt first.
          </p>
          <Cta href="/contact" class="mt-2 d-inline-block">Request Early Access</Cta>
        </div>
        <div class="col-lg-6 offset-lg-1 fade-in-right">
          <!-- Same accented cards as the Vision page's How We Work steps, so a
               numbered sequence looks the same wherever the site uses one. -->
          <div class="how-we-work-list">
            <div class="value-card hww-card a-nebula">
              <div class="hww-item">
                <div class="hww-num">01</div>
                <div>
                  <div class="hww-title">Built for a real need</div>
                  <p class="hww-body">Each tool starts from a gap our own teams hit — not a market we wanted to chase.</p>
                </div>
              </div>
            </div>
            <div class="value-card hww-card a-aurora">
              <div class="hww-item">
                <div class="hww-num">02</div>
                <div>
                  <div class="hww-title">Proven on production</div>
                  <p class="hww-body">It ships internally and survives daily use before it's considered ready for anyone else.</p>
                </div>
              </div>
            </div>
            <div class="value-card hww-card a-polaris">
              <div class="hww-item">
                <div class="hww-num">03</div>
                <div>
                  <div class="hww-title">Standalone, always</div>
                  <p class="hww-body">Every instrument runs without the rest. Take one, take none of the others, and it still does its job.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section section-padding">
    <div class="container">
      <div class="cta-block text-center fade-in-up">
        <h2 class="cta-title">Want a look before the rest of the world gets one?</h2>
        <p class="cta-sub">// early access · partnership · or just curious where this is heading</p>
        <Cta href="/contact" class="mt-3 d-inline-block">Get In Touch</Cta>
      </div>
    </div>
  </section>

</Base>
