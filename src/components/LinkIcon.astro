---
import SocialIcon from './SocialIcon.astro';
import PlatformIcon from './PlatformIcon.astro';

// Icons for the Compendium's outbound links, so a row of destinations reads
// as a row of destinations rather than a paragraph of words — the same move
// the Star Chart makes with its store links.
//
// The kind is derived from the label the README already carries (see
// `kindFor` below), so nothing in the catalog data has to be re-tagged.
// Brand marks come from the existing icon components; the rest are drawn
// here in one stroke weight so they sit together.
interface Props {
  kind: string;
}
const { kind } = Astro.props;

const strokes: Record<string, string[]> = {
  site: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z', 'M3.4 12h17.2', 'M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z'],
  download: ['M12 3.5v11', 'M7.5 10.5l4.5 4.5 4.5-4.5', 'M4.5 20h15'],
  releases: ['M3.5 11.2l8-8 9 9-8 8-9-9z', 'M7.8 7.6h.01'],
  docs: ['M4.5 5.2A2.2 2.2 0 0 1 6.7 3h11.8v18H6.7a2.2 2.2 0 0 1-2.2-2.2z', 'M8 7.5h7', 'M8 11.5h7'],
  marketplace: ['M5 8h14l-1.2 12H6.2z', 'M9 8a3 3 0 0 1 6 0'],
  web: ['M3.5 5.5h17v13h-17z', 'M3.5 9.5h17', 'M6.4 7.5h.01', 'M9 7.5h.01'],
  cloud: ['M7.5 18.5a4.2 4.2 0 0 1 .4-8.4 5.6 5.6 0 0 1 10.6 1.6 3.5 3.5 0 0 1-.6 6.8z'],
  trial: ['M12 3.2a8.8 8.8 0 1 0 0 17.6 8.8 8.8 0 0 0 0-17.6z', 'M12 7.4V12l3 2'],
  external: ['M14.5 4h5.5v5.5', 'M20 4l-8.5 8.5', 'M18 14.5V19a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 19V8a1.5 1.5 0 0 1 1.5-1.5H10'],
};
const d = strokes[kind];
---

{kind === 'repo' ? <SocialIcon key="github" />
  : kind === 'steam' ? <PlatformIcon key="steam" />
  : d && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      {d.map((path) => <path d={path} />)}
    </svg>
  )}
