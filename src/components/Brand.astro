---
// The brand lockup: logo mark plus the wordmark stacked three lines high —
// HYPER / QUANT / MEDIA — matching the brand asset's own composition.
//
// The mark is an image; the wordmark stays live text. The only wordmark asset
// available renders in white, which would vanish in light mode, and text also
// keeps the brand selectable, searchable, and legible at any size.
import { Image } from 'astro:assets';
import mark from '../assets/logo-mark.png';

interface Props {
  size?: 'nav' | 'footer' | 'lg';
}
const { size = 'nav' } = Astro.props;
// The mark's size in CSS px. It is published to CSS as --brand-mark-base so the
// wordmark can size itself against it: three lines of type occupying exactly
// the mark's height is the lockup's own composition, and hand-tuned font sizes
// per context drifted from it by 0.5-2.7px depending on where it was rendered.
//
// It is --brand-mark-BASE, not --brand-mark, deliberately: an inline style beats
// any stylesheet selector, so publishing the final value here would have made
// the below-lg shrink in style.css unreachable. CSS derives --brand-mark from
// this and stays free to override it per width.
// nav is 60 because that is the size style.css renders the nav lockup at (it
// sets --brand-mark from --nav-logo so the logo spans the bar). This number
// generates the srcset, so leaving it at the old 36 would have shipped a 36px
// 1x variant into a 60px box -- the under-specified case devview's image
// readout exists to catch. Below lg the lockup is smaller, which is the
// harmless direction: a larger asset scaled down.
const px = { nav: 60, footer: 32, lg: 64 }[size];
---

<span class={`brand-lockup brand-${size}`} style={`--brand-mark-base: ${px}px`}>
  <Image src={mark} alt="" width={px} height={px} densities={[1, 2, 3]} class="brand-mark" loading="eager" />
  <span class="brand-word"><span>Hyper</span><span>Quant</span><span>Media</span></span>
</span>
