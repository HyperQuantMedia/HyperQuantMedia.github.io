---
// The brand lockup: logo mark plus the wordmark stacked three lines high —
// HYPER / QUANT / MEDIA — matching the brand asset's own composition.
//
// The mark is an image; the wordmark stays live text. The only wordmark asset
// available renders in white, which would vanish in light mode, and text also
// keeps the brand selectable, searchable, and legible at any size.
import { Image } from 'astro:assets';
import mark from '../assets/logo-mark.png';

interface Props {
  size?: 'nav' | 'footer' | 'lg';
}
const { size = 'nav' } = Astro.props;
// The mark's size in CSS px. It is published to CSS as --brand-mark-base so the
// wordmark can size itself against it: three lines of type occupying exactly
// the mark's height is the lockup's own composition, and hand-tuned font sizes
// per context drifted from it by 0.5-2.7px depending on where it was rendered.
//
// It is --brand-mark-BASE, not --brand-mark, deliberately: an inline style beats
// any stylesheet selector, so publishing the final value here would have made
// the below-lg shrink in style.css unreachable. CSS derives --brand-mark from
// this and stays free to override it per width.
// nav is 60 because that is the size style.css renders the nav lockup at (it
// sets --brand-mark from --nav-logo so the logo spans the bar). This number
// generates the srcset, so leaving it at the old 36 would have shipped a 36px
// 1x variant into a 60px box -- the under-specified case devview's image
// readout exists to catch. Below lg the lockup is smaller, which is the
// harmless direction: a larger asset scaled down.
// footer is 72, and is the largest of the three on purpose: the footer's first
// column is a third of the container -- 380px at 1280 -- and the lockup is the
// only thing in it besides one line of type and a row of buttons. It went 32 ->
// 52 -> 72 across two passes, both times because it still read small against the
// room it has. This number generates the srcset as well as the box, so it moves
// both together -- raising it in CSS alone would ship a 32px 1x variant into a
// 72px box.
const px = { nav: 60, footer: 72, lg: 64 }[size];

// The nav lockup is the one of the three whose box is NOT the number above.
// Below lg, style.css swaps --brand-mark for the --nav-logo-sm clamp, so the
// rendered box runs from about 38px at 320px up to the 52px cap, and only
// reaches 60 at lg and wider. `densities` cannot express that -- it multiplies
// one fixed number -- so a 2x phone at 320px pulled the 120px variant into a
// 38px box, 3.2x more pixels than the box can show.
//
// `widths` + `sizes` hands the browser the real box instead and lets it pick.
// The breakpoints mirror style.css and must move with it:
//
//   >= 992px   60px, the flat --nav-logo
//   >= 380px   52px, the clamp sitting on its upper bound (it saturates at
//              378px: 2.02 x 52 + 84 = 189.04 = 50vw)
//   below      the clamp's own linear middle, which is exact down to 320px
//              (its 34px floor would only engage below a ~253px viewport)
//
// The ladder is every box x 1, 2 and 3, deduplicated: 38/52/60 at 1x, 76/104/120
// at 2x, 156/180 at 3x (114 and 113 round into 120). The source mark is 256px,
// so 180 is the real ceiling and nothing here asks for an upscale.
//
// Footer and lg keep `densities`: their boxes ARE the number above at every
// width, so there is nothing for a `sizes` string to tell the browser.
const NAV_WIDTHS = [38, 52, 60, 76, 104, 120, 156, 180];
const NAV_SIZES =
  '(min-width: 992px) 60px, (min-width: 380px) 52px, calc((50vw - 84px) / 2.02)';
---

<span class={`brand-lockup brand-${size}`} style={`--brand-mark-base: ${px}px`}>
  {size === 'nav' ? (
    <Image
      src={mark}
      alt=""
      width={px}
      height={px}
      widths={NAV_WIDTHS}
      sizes={NAV_SIZES}
      class="brand-mark"
      loading="eager"
    />
  ) : (
    <Image src={mark} alt="" width={px} height={px} densities={[1, 2, 3]} class="brand-mark" loading="eager" />
  )}
  <span class="brand-word"><span>Hyper</span><span>Quant</span><span>Media</span></span>
</span>
