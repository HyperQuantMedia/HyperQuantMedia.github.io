---
// The Industry Pedigree band: partner and credential logos with the credit
// line. One component, rendered on the homepage and the services page, so
// the grid and its ordering can never drift between the two.
//
// `feature` stretches the section to roughly two-thirds of the viewport and
// centres it — the homepage treatment, where the pedigree is meant to own
// the scroll stop it lands on.
import { Image } from 'astro:assets';
import { partners, creditLine } from '../data/partners.js';

interface Props {
  feature?: boolean;
}
const { feature = false } = Astro.props;

/* Tile sizing, measured rather than declared -- see the width sweep quoted in
   the commit. The two bands are IDENTICAL from 576px up; they diverge only
   below it, where the feature band runs four columns and the plain band three,
   so below 576 the plain band's tiles are the LARGER ones. That is the opposite
   of what the layout reads like, which is why `sizes` is passed per context
   instead of one string serving both.

     >= 992px   132px   fixed tile width
     768-991    163px   25% of a 696px grid -- the widest a tile ever gets
     576-767    118px   25% of a 516px grid
     < 576      feature 25% of the container, plain 33.33% of it

   The vw values are the top of each band's measured range with a little air:
   feature peaks at 22.5vw (108px at 480), plain at 30.2vw (145px at 480). */
const tileSizes = [
  '(min-width: 992px) 132px',
  '(min-width: 768px) 163px',
  '(min-width: 576px) 118px',
  feature ? '23vw' : '31vw',
].join(', ');

/* The source logos are 400x400, so 400 is the ceiling and a 163px tile on a 3x
   screen (which wants 489px) is served the best that exists. Everything else
   this ladder covers: 132px@1x, 118px@2x, 132px@2x, 163px@2x, and the phone
   boxes at 2x and 3x. It replaces densities={[1, 2]}, which could only ever
   offer 200 and 400 -- so every device at 2x or better pulled the 400px file
   into a 66-130px box, up to 3.03x more pixels than the box can show. */
const tileWidths = [132, 160, 200, 264, 330, 400];

// The glob is typed so <Image> gets ImageMetadata rather than unknown:
// `import: 'default'` alone leaves the value type open, and astro check
// then rejects every src below.
const modules = import.meta.glob<ImageMetadata>('../assets/logos/*.png', {
  eager: true,
  import: 'default',
});
const logos = Object.fromEntries(
  Object.entries(modules).map(([path, img]) => [
    path.split('/').pop().replace('.png', ''),
    img,
  ]),
);

const missing = partners.filter((p) => !logos[p.slug]).map((p) => p.slug);
if (missing.length) {
  throw new Error(`Missing logo assets for: ${missing.join(', ')}`);
}
---

<section class={feature ? 'experience-section section-padding pedigree-feature' : 'experience-section section-padding'}>
  <div class="container">
    <div class="text-center fade-in-up mb-5">
      <div class="section-label justify-content-center d-inline-flex">Industry Pedigree</div>
      <h2 class="section-title">Production experience our team carries</h2>
      <p class="section-sub mx-auto">Hands-on shipping experience from respected names across gaming and technology.</p>
    </div>
    <div class="logo-grid fade-in-up">
      {partners.map((p) => (
        <div class="logo-tile" title={`${p.name} — ${p.relation}`}>
          <Image src={logos[p.slug]} alt={p.name} width={400} height={400} widths={tileWidths} sizes={tileSizes} loading="lazy" />
        </div>
      ))}
    </div>
    <p class="logo-credit">{creditLine}</p>
    <!-- The voyage button: a capsule of space with a ship charting a course
         through the stars, flying toward the Star Chart. The ship rides an
         SVG animateMotion along the same path the dashes trace, so it scales
         with the button and needs no JavaScript. -->
    <div class="text-center mt-4">
      <a href="/credits" class="chart-voyage" aria-label="Explore the full Star Chart of shipped titles">
        <svg class="voyage-scene" viewBox="0 0 460 64" preserveAspectRatio="none" aria-hidden="true">
          <path id="voyageCourse" class="voyage-course" d="M14,46 C80,12 150,56 226,30 C300,6 372,50 446,18" />
          <g class="voyage-stars">
            <circle cx="46" cy="20" r="1.2" />
            <circle cx="98" cy="48" r="1" />
            <circle cx="150" cy="12" r="1.3" />
            <circle cx="205" cy="52" r="1" />
            <circle cx="262" cy="14" r="1.2" />
            <circle cx="318" cy="50" r="1" />
            <circle cx="368" cy="12" r="1.2" />
            <circle cx="424" cy="44" r="1" />
            <circle class="waypoint" cx="80" cy="27" r="1.8" />
            <circle class="waypoint" cx="226" cy="30" r="1.8" />
            <circle class="waypoint" cx="372" cy="27" r="1.8" />
          </g>
          <g class="voyage-ship">
            <path d="M0,-3.4 L9,0 L0,3.4 L2.4,0 Z" />
            <animateMotion dur="9s" repeatCount="indefinite" rotate="auto">
              <mpath href="#voyageCourse" />
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.92;1" dur="9s" repeatCount="indefinite" />
          </g>
        </svg>
        <span class="voyage-text">Explore the Full Star Chart of Shipped Titles <span class="voyage-arrow" aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</section>
