---
// Bottom-right scroll-to-top control. Hidden until the reader is far enough
// down that it is useful; wired up in js/app.js.
---

<button class="to-top" type="button" id="toTop" aria-label="Back to top" title="Back to top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>
