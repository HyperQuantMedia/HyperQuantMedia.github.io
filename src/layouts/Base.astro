---
// The page shell: head, navbar, slotted content, footer, scripts.
//
// Every page goes through here, so head tags and the nav/footer are defined
// once. The constellation canvas lives here too, so it is one continuous
// field across the whole site rather than a home-page-only flourish.
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { site, analytics } from '../data/site.js';
import { pageGraph } from '../data/schema.js';
import '../styles/style.css';

// Title convention, so tabs and search results stay one family:
//
//   <Page> — <what it is> | HyperQuant Media      (every page)
//   HyperQuant Media — <what we are>              (the homepage only)
//
// Em dash between the page and its descriptor, pipe before the brand, brand
// last, and the whole thing under ~60 characters so search results do not
// truncate it. The descriptor is not decoration - it is where the words
// someone would actually search for belong.
interface Props {
  title: string;
  description: string;
  page: string;
  /* Extra JSON-LD nodes to append to this page's @graph. Built by the helpers
     in src/data/schema.js from the same data the page renders, so the markup
     and the structured data cannot drift. */
  schema?: object[];
  /* Keep the page out of the index while still following its links. Only the
     404 needs it: GitHub Pages already answers 404.html with a 404 status, and
     this is the belt to that braces. */
  noindex?: boolean;
}
const { title, description, page, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
const graph = pageGraph({ page, title, description, canonical, nodes: schema });
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <!-- Matches the solid navbar ground (--nav-scrim), not the page floor: on a
       phone the browser chrome sits directly above the fixed bar, so those two
       colours meeting is the seam the reader actually sees. -->
  <meta name="theme-color" content="#07071a" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />

  <!-- Runs before first paint so a stored theme choice never flashes the
       other palette. Deliberately inline and un-deferred; nothing here can
       wait for a bundle. No stored choice means no attribute, which leaves
       the CSS to follow the system preference. -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('hqm-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) {
        /* private mode or storage disabled: fall through to system preference */
      }

      // Client-side navigation replaces <html>'s attributes with the ones
      // from the incoming static page, which drops a theme chosen at
      // runtime. Re-apply it the moment the swap lands, before paint.
      document.addEventListener('astro:after-swap', function () {
        try {
          var t = localStorage.getItem('hqm-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) { /* same fallback as above */ }
      });
    })();
  </script>

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <!-- The prose is British English (centre, colour, licence, optimisation),
       so the locale says so rather than defaulting to en_US. -->
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="HyperQuant Media — logo mark and wordmark on a starfield" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <!-- Client-side routing. The constellation canvas is marked
       transition:persist below, so navigating swaps the page *inside* the
       field instead of tearing the field down -- the whole site behaves as
       one continuous space. Browsers without the View Transitions API just
       get instant swaps; no-JS visitors get ordinary full loads. -->
  <ClientRouter />

  <!-- Everything below is served from this origin. Bootstrap, three.js and the
       four font families used to come from jsdelivr and Google at runtime,
       which meant a page could render wrong for reasons that had nothing to do
       with this repo. That stopped being theoretical: a responsive audit run
       caught ERR_CONNECTION_RESET on the jsdelivr Bootstrap CSS, and that page
       lost `d-none` and the collapse plugin outright — the desktop social row
       showed at 480px and the hamburger was inert.

       Files live in public/vendor/ and are committed. Bootstrap and three.js
       are the upstream minified builds, pinned by the version in the path
       comment below; the fonts are regenerated by tools/vendor-fonts.mjs. -->
  <!-- A custom Bootstrap build, not the full one: coverage measured the stock
       bootstrap.min.css at 4.8% used across all nine pages, and GitHub Pages
       caps every asset at max-age=600 so the other 216 KB was re-downloaded
       every ten minutes. Compiled from Bootstrap 5.3.3 sources by
       tools/vendor-bootstrap.mjs, which refuses to write a build missing any
       Bootstrap class the built HTML uses. Reboot is kept: style.css has
       grown around its resets. -->
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.custom.min.css" /><!-- from bootstrap 5.3.3 -->

  <!-- Same-origin now, so the fonts are discovered in the same round trip as
       the stylesheet rather than after two extra DNS+TLS handshakes. The two
       preloads are the faces on every page above the fold: Inter sets the body
       copy, Space Mono the nav and every label. -->
  <link rel="preload" href="/vendor/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/vendor/fonts/space-mono-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fonts/fonts.css" />

  <!-- Structured data as ONE @graph, not a pile of blocks: Organization and
       WebSite are declared once with stable @ids and everything else points at
       them, so a crawler seeing nine pages sees one company and one site
       rather than nine near-identical guesses. Built in src/data/schema.js
       from the same data the page renders. -->
  <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

  <slot name="head" />

  <!-- Visit analytics (Umami): renders only when a website id is configured
       in src/data/site.js, so the codebase carries the wiring but ships no
       tracker until the owner activates it. Cookieless; no consent banner
       required. -->
  {analytics.umami.websiteId && (
    <script
      defer
      src={analytics.umami.src}
      data-website-id={analytics.umami.websiteId}
      is:inline
    ></script>
  )}
</head>
<body data-page={page}>

  <!-- The constellation field, behind every page rather than only the home
       hero. Sits in the layout so navigating never drops the reader out of
       it. Decorative: aria-hidden, pointer-events none, and it degrades to
       the CSS star wash if WebGL or JS is unavailable. -->
  <canvas id="siteCanvas" aria-hidden="true" transition:persist="starfield"></canvas>

  <!-- Reading-progress hairline. Driven from the same rAF scroll handler as
       the navbar state in js/app.js. -->
  <div id="scrollProgress" aria-hidden="true"></div>

  <!-- Cursor comet trail: drawn above the content, where the starfield
       canvas cannot reach. Persisted so mid-flight dust survives page
       swaps. Decorative and untouchable. -->
  <canvas id="cometCanvas" aria-hidden="true" transition:persist="comet"></canvas>

  <Nav page={page} />

  <slot />

  <Footer />

  <BackToTop />

  <!-- Bootstrap's JS is gone. The only plugin in use was Collapse, driving the
       navbar toggler, and that is a class swap plus a height transition — 23.7 KB
       gzipped for one control. js/app.js does it directly now, against the same
       .collapse / .collapsing / .show classes the CSS build still provides. -->
  <script src="/js/comet.js" is:inline></script>
  <script src="/js/app.js" is:inline></script>

  <!-- The starfield, off the critical path.
       three.js plus this scene was 45% of the site's transfer and it draws a
       decorative background, so it is no longer in the document at all: this
       waits for the browser to be idle after first paint, then imports the
       scene module, which pulls in the tree-shaken three chunk with it.
       Nothing is lost visually — #siteCanvas starts at opacity 0 and fades in
       over 1.2s once the scene marks itself live, and body::before paints a
       static CSS star wash underneath in the meantime (and permanently, for
       anyone without JS or WebGL).
       The timeout is the ceiling, not the target: a busy main thread must not
       mean no starfield at all. Safari has no requestIdleCallback, hence the
       load-event fallback. -->
  <script>
    const startField = () => import('../scripts/scene.js');
    // Feature-tested with typeof rather than `'requestIdleCallback' in window`:
    // the DOM lib declares the method as required, so an `in` check narrows the
    // else branches to `never` and astro check rejects window.addEventListener.
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(startField, { timeout: 2500 });
    } else if (document.readyState === 'complete') {
      setTimeout(startField, 200);
    } else {
      window.addEventListener('load', () => setTimeout(startField, 200), { once: true });
    }
  </script>
  {/* The 404 minigame ships with the 404 page and nowhere else. It also
      re-initialises on astro:page-load, since the client-side router can swap
      into this page without re-running the file. */}
  {page === '404' && <script src="/js/lost.js" is:inline></script>}
</body>
</html>
